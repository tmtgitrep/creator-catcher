[Unit]
Description=Run a due Creator Catcher automatic scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=creator-catcher
Group=creator-catcher
EnvironmentFile=-/etc/default/creator-catcher
ExecStart=/usr/bin/creator-catcher scheduled-scan
StateDirectory=creator-catcher
WorkingDirectory=/var/lib/creator-catcher
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/creator-catcher -/mnt -/media -/srv
